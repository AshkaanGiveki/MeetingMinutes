# -----------------------------------------------------------------------------
# Accord Environment Configuration
# -----------------------------------------------------------------------------

# Application Service URL
APP_URL="https://metameet.ir"
PORT=3000
NODE_ENV="development"

# AI Minutes Assistant
# Set AI_PROVIDER to auto, gemini, openai, or anthropic.
AI_PROVIDER="auto"
AI_MODEL=""
AI_REQUEST_TIMEOUT_MS="45000"
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_MODEL="gemini-2.5-flash"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_TRANSCRIPTION_MODEL="gpt-4o-mini-transcribe"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-haiku-latest"

# MongoDB Database Connection
# Active MongoDB connection string (Atlas or self-hosted)
MONGODB_URI="mongodb+srv://<user>:<password>@cluster.mongodb.net/metameet?retryWrites=true&w=majority"

# Upstash Redis (Free Tier)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Upstash QStash (Serverless Message Queue)
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""

# Security & Authentication Secret
AUTH_SECRET="your-32-character-random-hex-string-here"
SESSION_COOKIE_NAME="metameet_session"
# Optional first-deployment owner bootstrap; never commit the password.
BOOTSTRAP_ADMIN_EMAIL="owner@example.com"
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_PHONE=""
BOOTSTRAP_ADMIN_NAME="Accord Owner"

# Transactional Email Providers: 'console' (default, no SMTP needed), 'resend', or 'smtp'
EMAIL_PROVIDER="console"
EMAIL_API_KEY=""
SMTP_HOST=""
SMTP_PORT=""
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Accord <notifications@metameet.ir>"

# SMS.ir OTP provider (required for production phone login/signatures)
SMS_PROVIDER="sms.ir"
SMS_API_KEY=""
SMS_USERNAME=""
SMS_LINE_NUMBER=""

# Telegram Bot Integration (Persian PM with Accept / Reject / View Website buttons)
TELEGRAM_BOT_TOKEN=""
# Optional reachable Bot API endpoint/proxy. Defaults to https://api.telegram.org.
TELEGRAM_API_BASE_URL="https://api.telegram.org"
TELEGRAM_WEBHOOK_SECRET=""
# Optional Telegram username or chat ID for internal signature alerts. Leave empty to disable this alert.
TELEGRAM_ALERT_CHAT_ID=""

# Storage Provider for Attachments: 'local', 's3', or 'vercel-blob'
STORAGE_PROVIDER="local"
STORAGE_BUCKET="metameet-documents"
# Relative paths use the working directory locally and os.tmpdir()/accord on Vercel.
# Vercel PDFs are temporary; absolute overrides must point to writable storage.
DOCUMENT_STORAGE_PATH="./storage/documents"
# Optional: absolute path to a Persian-capable TTF/OTF font used in generated PDFs.
PERSIAN_FONT_PATH="src/assets/fonts/IRANSansXFaNum-Regular.woff2"
