{
  "installCommand": "npm install --include=dev",
  "buildCommand": "npm run build && npx esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=api/server.mjs",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "includeFiles": "{src/assets/fonts/*.woff2,node_modules/@sparticuz/chromium/bin/**}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
